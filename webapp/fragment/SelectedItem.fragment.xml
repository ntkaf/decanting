<core:FragmentDefinition
  xmlns:core="sap.ui.core"
  xmlns:f="sap.ui.layout.form"
  xmlns="sap.m">
  <Page id="masterProductsDetailsPage" title="Products" class="sapUiNoContentPadding" showNavButton="true" navButtonPress="onBackToProductsListPress">
<f:SimpleForm id="SimpleFormDisplay354"
			editable="false"
			layout="ResponsiveGridLayout"
			title="{data>material/description}"
			labelSpanXL="3"
			labelSpanL="3"
			labelSpanM="3"
			labelSpanS="4"
			adjustLabelSpan="false"
			emptySpanXL="4"
			emptySpanL="4"
			emptySpanM="4"
			emptySpanS="0"
			columnsXL="1"
			columnsL="1"
			columnsM="1"
			singleContainerFullSize="false" >
			<f:content>
				<Label text="Id" />
				<Text id="nameText" text="{data>itemId}" />
				<Label text="EAN" />
				<Text text="{data>ean}" />
				<Label text="PO" />
				<Text text="{data>poNumber}" />
				<Label text="Vendor" />
				<Text text="{data>vendor/name}" />
        <Label text="L / W / H" />
				<Text text="{data>dimensions/lengthCm} / {data>dimensions/widthCm} / {data>dimensions/heightCm} cm" />
        <Label text="Total Volume" />
				<Text text="{volumeM3} m3" />
        <Label text="Weight" />
				<Text text="{data>weightKg} kg" />

			</f:content>
		</f:SimpleForm> 
  </Page>
</core:FragmentDefinition>