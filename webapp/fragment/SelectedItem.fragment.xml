<core:FragmentDefinition
  xmlns:core="sap.ui.core"
  xmlns:f="sap.ui.layout.form"
  xmlns="sap.m">
  <Page id="masterProductsDetailsPage" title="Products" class="sapUiResponsiveContentPadding" showNavButton="true" navButtonPress="onBackToProductsListPress">

<Panel 
       backgroundDesign="Translucent"
	   
       class="vcpCard sapUiSmallMarginBottom">
	   <Title text="{data>material/description}" wrapping="true"/>
<f:SimpleForm 
			editable="false"
			layout="ResponsiveGridLayout"		
			labelSpanXL="3"
			labelSpanL="3"
			labelSpanM="3"
			labelSpanS="4"
			adjustLabelSpan="false"
			emptySpanXL="4"
			emptySpanL="4"
			emptySpanM="4"
			emptySpanS="0"
			columnsXL="1"
			columnsL="1"
			columnsM="1"
			singleContainerFullSize="false" >
			<f:content>
				<Label text="{i18n>xtit.Id}" />
				<Text id="nameText" text="{data>itemId}" />
				<Label text="{i18n>xtit.EAN}" />
				<Text text="{data>ean}" />
				<Label text="{i18n>xtit.PO}" />
				<Text text="{data>poNumber}" />
				<Label text="{i18n>xtit.Vendor}" />
				<Text text="{data>vendor/name}" />
        <Label text="{i18n>xtit.LHW}" />
				<Text text="{data>dimensions/lengthCm} / {data>dimensions/widthCm} / {data>dimensions/heightCm} cm" />
        <Label text="{i18n>xtit.Volume}" />
				<Text text="{data>volumeM3} m3" />
        <Label text="{i18n>xtit.Weight}" />
				<Text text="{data>weightKg} kg" />
				<Label text="{i18n>xtit.Number}" />
				<Text text="{data>quantity/amount} {data>quantity/uom}" />
				<Label text="{i18n>xtit.ExpirationDate}" />
				<Text text="{path:'data>expirationDate', formatter:'.formatter.onFormatDate'}" />
				<Label text="{i18n>xtit.NextdestBin}" />
				<Text text="{data>destinationBin}" />
				<Label text="{i18n>xtit.FinalDestBin}" />
				<Text text="{data>destinationBin}" />

				
			</f:content>
		</f:SimpleForm> 
		<HBox>
		<Button text="{i18n>xtit.PrintLabels}" press="onPressPrintLabel" class="sapUiSmallMarginEnd"/>
		<Button text="{i18n>xtit.SetExpirationDate}" press="onPressSetExpirationDate" />
		
		<!-- <Button text="{i18n>ChangeDestinationBin}" press="onPressChangeDestinationBin" /> -->
		</HBox>
<HBox>

		<Button text="{i18n>xtit.ChangeDestinationBin}" press="onPressChangeDestinationBin" />
		<!-- <Button text="{i18n>ChangeDestinationBin}" press="onPressChangeDestinationBin" /> -->
		</HBox>
		</Panel>
		<VBox alignContent="Center" justifyContent="Center" alignItems="Center">
		
		</VBox>
		<!-- <footer> 
		<Toolbar>
		<Button text="{i18n>PrintLabels}" press="onPressPrintLabel" type="Emphasized"/>
		</Toolbar>
		</footer> -->
  </Page>
</core:FragmentDefinition>