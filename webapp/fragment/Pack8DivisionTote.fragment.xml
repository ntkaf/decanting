		id="oh1"
		responsive="true"
		binding=""
		intro="Selected item"
		title="8-Division Tote"

		backgroundDesign="Translucent">
    	<statuses>
			<ObjectStatus title="Tote ID" text="TOTE-2354922" state="Information"/>
		</statuses>
    	<headerContainer>
      </headerContainer>
    </ObjectHeader> -->
    	<ux:ObjectPageHeader id="headerForTest"
							  objectTitle="TOTE-2354922"							  
							  objectSubtitle="8-Division Tote"
							  isActionAreaAlwaysVisible="true"
							  showPlaceholder="true">
				<!-- <ux:navigationBar>
					<Bar>
						<contentLeft>
							<Button icon="sap-icon://nav-back" tooltip="nav-back"/>
						</contentLeft>
						<contentMiddle>
							<Text text="Employee Profile"/>
						</contentMiddle>
					</Bar>
				</ux:navigationBar> -->
				<ux:actions>
					<ux:ObjectPageHeaderActionButton press="onCompleteTotePress" text="Complete Tote" tooltip="tree" hideText="false" type="Emphasized"/>
					<ux:ObjectPageHeaderActionButton press="onChangeTotePress" text="Change Tote" tooltip="action" hideText="false" type="Emphasized"/>
				</ux:actions>
			</ux:ObjectPageHeader>
    <content>
      <VBox alignItems="Center" justifyContent="Center" width="100%" height="100%" class="tote8Container">        
        <Text text="A" class="toteLabel toteLabelTop"/>
        <HBox alignItems="Center" justifyContent="Center" class="toteBoardRow">         
          <Text text="B" class="toteLabel toteLabelLeft"/>
        
          <FlexBox id="tote8Grid"
                     alignItems="Stretch"
                     justifyContent="SpaceBetween"
                     wrap="Wrap"
                     class="toteGrid"
                     items="{data>/totes}">
            <f:Card class="toteCell">
              <f:layoutData>                
                <FlexItemData baseSize="20%" growFactor="1"/>
              </f:layoutData>
              <f:content>
              <VBox alignItems="Center" justifyContent="Center" width="100%">
              <Title text="{data>name}"/>                
                <Button type="Transparent" icon="sap-icon://add" width="100%" height="100%" press=".onPressDivision" class="toteCellBtn" app:divisionId="{data>id}"/>
                <StepInput
                id="StepInputProductId"
                width="6rem"
						value="{data>/selectedItem/quantity/amount}"
						min="1"
						max="{data>/selectedItem/quantity/amount2}"
            visible="{= ${data>status} === 'selected'? true: false}"/>
            <Button width="100%" press=".onCloseTote" text="Close" class="toteCellBtn" app:divisionId="{data>id}" visible="{= ${data>status} === 'selected'? true: false}"/>
            <Text text="{data>itemDescription}" visible="{= ${data>status} === 'closed'? true: false}" class="sapUiSmallMargin"/>
            
                </VBox>
              </f:content>
            </f:Card>
          </FlexBox>          
          <Text text="D" class="toteLabel toteLabelRight"/>
        </HBox>        
        <Text text="C" class="toteLabel toteLabelBottom"/>
      </VBox>
    </content>
  </Page>
  </core:FragmentDefinition>