<core:FragmentDefinition
  xmlns:core="sap.ui.core"
  xmlns:f="sap.f"
  xmlns="sap.m"
  xmlns:ux="sap.uxap"
  xmlns:control="com.westernacher.decanting.ui.controls"
  xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1">
  <Page id="detailPack8DivisionPage" class="sapUiNoContentPadding" showNavButton="true" navButtonPress="onBackToSelectTotePress"   
  title="{i18n>xtit.WorkCenter}: {data>/SelectedWorkCenter}">
    	<!-- <ObjectHeader
		id="oh1"
		responsive="true"
		binding=""
		intro="Selected item"
		title="8-Division Tote"

		backgroundDesign="Translucent">
    	<statuses>
			<ObjectStatus title="Tote ID" text="TOTE-2354922" state="Information"/>
		</statuses>
    	<headerContainer>
      </headerContainer>
    </ObjectHeader> -->
    	<ux:ObjectPageHeader id="headerForTest"
							  objectTitle="{i18n>xtit.Tote}-{data>ToteId}"							  
							  objectSubtitle="{i18n>xtit.8DivisionTote}"
							  isActionAreaAlwaysVisible="true"
							  showPlaceholder="true">
				<!-- <ux:navigationBar>
					<Bar>
						<contentLeft>
							<Button icon="sap-icon://nav-back" tooltip="nav-back"/>
						</contentLeft>
						<contentMiddle>
							<Text text="Employee Profile"/>
						</contentMiddle>
					</Bar>
				</ux:navigationBar> -->
				<ux:actions>
					<ux:ObjectPageHeaderActionButton press="onCompleteTotePress" text="{i18n>xtit.CompleteTote}" tooltip="tree" hideText="false" type="Default"/>
					<ux:ObjectPageHeaderActionButton press="onChangeTotePress" text="{i18n>xtit.ChangeTote}" tooltip="action" hideText="false" type="Default"/>
				</ux:actions>
			</ux:ObjectPageHeader>
    <content>
    <MessageStrip
				text="{i18n>xtit.FirstTimeProductMessage}"
				type="Information"
				showIcon="true"
				showCloseButton="false"
				class="sapUiMediumMargin"
        visible="{= ${data>/selectedItem/flags/firstReceipt}=== true? true: false}"/>
           <MessageStrip
				text="{i18n>xtit.RequiresReconditioningMessage}"
				type="Information"
				showIcon="true"
				showCloseButton="false"
				class="sapUiMediumMargin"
        visible="{= ${data>/selectedItem/flags/requiresReconditioning}=== true? true: false}"/>


      <control:Tote id="tote8Grid" labelTop="{i18n>xtit.A}" labelBottom="{i18n>xtit.D}" labelLeft="{i18n>xtit.B}" labelRight="{i18n>xtit.C}" divisions="{data>toteDivisions}">
          <control:divisions>
            <control:ToteDivision title="{data>name}" titleCloseButton="{i18n>xtit.Close}" 
                  close="onCloseToteV2" productDescription="{data>itemDescription}" packedQuantity="{data>scanedAmount}" unit="{data>uom}" 
                  quantity="{parts:[{path: 'data>/selectedItem/quantity/amount'},{path: 'data>/selectedItem/quantity/scanedAmount'}], formatter: '.formatter.onFormatAvailableAmount'}"
                  quantityMaxValue="{data>/selectedItem/quantity/amount2}" state="{data>status}">
                  
               </control:ToteDivision> 
               </control:divisions>
      </control:Tote>
     
    </content>
  </Page>
  </core:FragmentDefinition>