<core:FragmentDefinition
  xmlns:core="sap.ui.core"
  xmlns:ux="sap.uxap"
  xmlns:l="sap.ui.layout"
	xmlns:f="sap.ui.layout.form"
  xmlns:control="com.westernacher.decanting.ui.controls"
  xmlns="sap.m">
  <Page id="masterProductsPage" >
    <content>
    <Toolbar>
     <core:Icon src="sap-icon://product" class="sapUiTinyMarginEnd"/>
            <Title text="{i18n>HUDetails}"/>
            </Toolbar>
    <VBox class="huHeaderBorder sapUiTinyMargin">
    
    <Title text="{data>/123/huId}" level="H1" titleStyle="H3" class="sapUiSmallMarginBegin sapUiTinyMargin"/>
   
			<l:VerticalLayout class="sapUiSmallMargin">
      <HBox>
      <core:Icon src="sap-icon://map" color="blue" class="sapUiSmallMarginEnd"/>
				<ObjectStatus title="Location" text="{data>/123/Location}"/>
        </HBox>
        
        <HBox>
      <core:Icon src="sap-icon://date-time" color="blue" class="sapUiSmallMarginEnd"/>
				<ObjectStatus title="Scanned" text="17:03:21"/>
        
        </HBox>
        <Button text="{i18n>CloseHuDecanting}" class="sapUiSmallMarginTop" press="onCloseHUDecanting"/>
			</l:VerticalLayout>
         
            </VBox>
            <Toolbar>
            <core:Icon src="sap-icon://lightbulb" class="sapUiTinyMarginEnd"/>
            <Title text="{i18n>Products}"/>
            </Toolbar>
              <Toolbar>
            <Input placeholder="{i18n>ScanProduct}" />
            </Toolbar>
      <List
        id="listProducts"
        items="{
          path: 'data>/123/items',
          sorter: [{path: 'status', descending: false}]
        }"
        mode="None"
        itemPress=".onProductItemPress"
        growing="true"
        growingScrollToLoad="true"
        showSeparators="All">
        <control:CustomListItemExt type="Active" class="vcpProductCard" highlight="{path:'data>status', formatter:'.formatter.onFormatStatusIndication'}"
          title="{data>material/description}" ean="{data>ean}" po="{data>poNumber}" vendor="{data>vendor/name}" number="{data>quantity/scanedAmount}/{data>quantity/amount}">
         </control:CustomListItemExt> 
       <!--<CustomListItem type="Active" class="vcpProductCard" highlight="{path:'data>status', formatter:'.formatter.onFormatStatusIndication'}">
        <VBox class="sapUiTinyMargin vcpProductCard__inner">
        <HBox>
        <Title text="{data>material/description}" wrapping="true" class="sapUiTinyMarginBottom"/>
        </HBox>
          <HBox justifyContent="SpaceBetween" alignItems="End" alignContent="SpaceBetween" width="100%" >
          
            <VBox width="75%">
              <ObjectStatus title="EAN" text="{data>ean}"/>
              <ObjectStatus title="PO" text="{data>poNumber}"/>
              <ObjectStatus title="Vendor" text="{data>vendor/name}"/>
              
            </VBox>

           
            <VBox width="25%" alignItems="End" alignContent="End" justifyContent="End" height="100%">
              <ObjectNumber number="{data>quantity/scanedAmount}/{data>quantity/amount}" emphasized="true" class="sapMObjectNumberLarge" state="Information"/>
              
            </VBox>
          </HBox>
          </VBox>

        </CustomListItem>-->

      </List>
    </content>
  </Page>
</core:FragmentDefinition>
