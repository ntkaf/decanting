<mvc:View controllerName="com.westernacher.decanting.controller.ScanWorkCenter"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core">
    <Page id="scanWorkCenterPage" enableScrolling="false">
    <content>
   
      <FlexBox
        alignItems="Center"
        justifyContent="Center"
        fitContainer="true"
        class="sapUiResponsiveContentPadding scanContainer">

        <f:Card width="28rem" class="scanCard">
          <f:content>
            <VBox alignItems="Center" justifyContent="Center" width="100%" class="scanCardContent">
              <core:Icon src="sap-icon://projector" size="4rem"/>
              <Title level="H1" class="sapUiSmallMarginTop" text="{i18n>ScanWorkCenter}" />
              <Input
                width="12rem"
                id="ScanWorkCenterInput"
                placeholder="{i18n>ScanOrEnterWorkstation}"
                class="sapUiMediumMarginTop"/>
                <Button text="{i18n>Next}" press="onPressConfirmWorkStationButton" width="12rem"/>
            </VBox>
          </f:content>
        </f:Card>

      </FlexBox>
    </content>
  </Page>
    </mvc:View>