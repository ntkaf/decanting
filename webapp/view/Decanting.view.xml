    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
	xmlns:core="sap.ui.core">
<SplitApp
		id="SplitAppDemo"
		initialDetail="detail"
		initialMaster="master"
		detailNavigate="onDetailNavigate">
		<detailPages>
			<core:Fragment fragmentName="com.westernacher.decanting.fragment.NoItemSelectedPage" type="XML"/>
			<core:Fragment fragmentName="com.westernacher.decanting.fragment.SelectBoxType" type="XML"/>
			<core:Fragment fragmentName="com.westernacher.decanting.fragment.Pack8DivisionTote" type="XML"/>
			<core:Fragment fragmentName="com.westernacher.decanting.fragment.DetailPackOtherPage" type="XML"/>
		</detailPages>
		<masterPages>			
			<core:Fragment fragmentName="com.westernacher.decanting.fragment.ProductsList" type="XML"/>
			<core:Fragment fragmentName="com.westernacher.decanting.fragment.SelectedItem" type="XML"/>
		</masterPages>
	</SplitApp>
</mvc:View>